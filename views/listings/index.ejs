<% layout("/layouts/boilerplate") %>
  <style>
    .listing-link {
      display: flex;
    }

    #filters {
      display: flex;
      flex-wrap: nowrap;
      align-items: center;
      margin-top: 1rem;
      overflow-x: visible;
    }

    .filter {
      text-align: center;
      margin-top: 1rem;
      opacity: 0.7;
      transition: 0.2s;
      width: auto !important;
      /* Allow width to be determined by content */
      padding: 0 10px;
    }

    .filter:hover {
      opacity: 1;
      cursor: pointer;
      border-bottom: 2px solid black;
    }

    .filter.active {
      opacity: 1;
      border-bottom: 2px solid black;
    }

    .filter p {
      font-size: 0.8rem;
      margin-top: 0.5rem;
    }

    .swiper {
      width: 75%;
      margin-left: 0;
      margin-right: 0;
    }

    .swiper-slide {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .tax-toggle {
      border: 1px solid rgba(0, 0, 0, 0.2);
      border-radius: 12px;
      height: 3.5rem;
      padding: 0 1rem;
      display: flex;
      align-items: center;
      margin-left: auto;
      white-space: nowrap;
    }

    .tax-info {
      display: none;
    }

    @media (max-width: 992px) {
      .swiper {
        width: 100%;
        margin-bottom: 1rem;
      }

      #filters {
        flex-direction: column;
        align-items: flex-start;
      }

      .tax-toggle {
        margin-left: 0;
        width: 100%;
        justify-content: space-between;
      }
    }
  </style>

  <body>
    <div class="container-fluid mt-3 mb-2">
      <div id="filters">
        <div class="swiper mySwiper">
          <div class="swiper-wrapper">
            <div class="filter swiper-slide <%= category === 'Trending' ? 'active' : '' %>"
              onclick="window.location.href='/listings?category=Trending'">
              <i class="fa-solid fa-fire"></i>
              <p>Trending</p>
            </div>
            <div class="filter swiper-slide <%= category === 'Rooms' ? 'active' : '' %>"
              onclick="window.location.href='/listings?category=Rooms'">
              <i class="fa-solid fa-bed"></i>
              <p>Rooms</p>
            </div>
            <div class="filter swiper-slide <%= category === 'Iconic Cities' ? 'active' : '' %>"
              onclick="window.location.href='/listings?category=Iconic+Cities'">
              <i class="fa-solid fa-mountain-city"></i>
              <p>Iconic Cities</p>
            </div>
            <div class="filter swiper-slide <%= category === 'Mountain' ? 'active' : '' %>"
              onclick="window.location.href='/listings?category=Mountain'">
              <i class="fa-solid fa-mountain"></i>
              <p>Mountain</p>
            </div>
            <div class="filter swiper-slide <%= category === 'Castles' ? 'active' : '' %>"
              onclick="window.location.href='/listings?category=Castles'">
              <i class="fa-brands fa-fort-awesome"></i>
              <p>Castles</p>
            </div>
            <div class="filter swiper-slide <%= category === 'Amazing Pools' ? 'active' : '' %>"
              onclick="window.location.href='/listings?category=Amazing+Pools'">
              <i class="fa-solid fa-person-swimming"></i>
              <p>Amazing Pools</p>
            </div>
            <div class="filter swiper-slide <%= category === 'Camping' ? 'active' : '' %>"
              onclick="window.location.href='/listings?category=Camping'">
              <i class="fa-solid fa-campground"></i>
              <p>Camping</p>
            </div>
            <div class="filter swiper-slide <%= category === 'Farms' ? 'active' : '' %>"
              onclick="window.location.href='/listings?category=Farms'">
              <i class="fa-solid fa-cow"></i>
              <p>Farms</p>
            </div>
            <div class="filter swiper-slide <%= category === 'Arctic' ? 'active' : '' %>"
              onclick="window.location.href='/listings?category=Arctic'">
              <i class="fa-regular fa-snowflake"></i>
              <p>Arctic</p>
            </div>
          </div>
        </div>

        <div class="tax-toggle ms-md-3">
          <div class="form-check form-switch form-check-reverse">
            <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
            <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
          </div>
        </div>
      </div>

      <div class="row row-cols-xxl-4 row-cols-lg-3 row-cols-md-2 row-cols-1 g-4 mt-2">
        <% if(allListings.length> 0) { %>
          <% for(let listing of allListings){ %>
            <div class="col">
              <a href="/listings/<%= listing._id %>" class="listing-link">
                <div class="card h-100 w-100 border-0 shadow-sm rounded-4 overflow-hidden">
                  <img src="<%= listing.image.url%>" class="card-img-top" alt="listing image"
                    style="height: 18rem; object-fit: cover;" />
                  <div class="card-body p-3">
                    <h5 class="card-title mb-1 fw-bold text-dark">
                      <%= listing.title%>
                    </h5>
                    <p class="card-text text-secondary mb-0">
                      <span class="fw-bold text-dark">&#8377; <%= listing.price.toLocaleString("en-IN") %></span> /
                      night
                      <span class="tax-info ms-2 text-primary font-monospace">+18% GST</span>
                    </p>
                  </div>
                </div>
              </a>
            </div>
            <% } %>
              <% } else { %>
                <div class="col-12 col-md-6 col-lg-4 col-xl-3 col-xxl-2 text-center mt-5">
                  <div class="no-listings-found">
                    <i class="fa-solid fa-search-minus fa-4x text-secondary mb-3"></i>
                    <h3 class="text-secondary">No listings found for "<%= category %>"</h3>
                    <p class="text-muted">Try exploring other categories or check back later.</p>
                    <a href="/listings" class="btn btn-danger mt-3" style="border-radius: 20px;">Show all listings</a>
                  </div>
                </div>
                <% } %>
      </div>
    </div>
  </body>

  <script>
    let taxSwitch = document.getElementById("flexSwitchCheckDefault");
    taxSwitch.addEventListener("click", () => {
      let taxInfo = document.getElementsByClassName("tax-info");
      for (let info of taxInfo) {
        if (info.style.display != "inline") {
          info.style.display = "inline";
        } else {
          info.style.display = "none";
        }
      }
    });

    var swiper = new Swiper(".mySwiper", {
      slidesPerView: "auto",
      spaceBetween: 20,
      freeMode: true,
      mousewheel: true,
    });
  </script>

