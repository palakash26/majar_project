<% layout("/layouts/boilerplate") %>
<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="row mt-4 mb-5">
    <div class="col-lg-8 col-md-10 mx-auto">
        <!-- Listing Header Title & Location -->
        <div class="mb-3">
            <h2 class="fw-bold text-dark mb-1"><%= listing.title %></h2>
            <p class="text-muted mb-0">
                <i class="fa-solid fa-location-dot text-danger me-1"></i>
                <%= listing.location %>, <%= listing.country %>
            </p>
        </div>

        <!-- Main Image Banner with Heart Toggle -->
        <div class="show-img-wrapper mb-4 position-relative overflow-hidden rounded-4 shadow-sm">
            <img src="<%= listing.image.url %>" class="w-100 show-img object-fit-cover" alt="listing_image">
            <div class="position-absolute top-0 end-0 m-3 d-flex align-items-center gap-2">
                <button class="wishlist-heart-btn shadow-sm" type="button" title="Toggle Wishlist" onclick="toggleWishlist(event, '<%= listing._id %>')" style="position: relative; top: auto; right: auto; width: 38px; height: 38px; font-size: 1.1rem;">
                    <i class="<%= (typeof userWishlist !== 'undefined' && userWishlist && userWishlist.includes(listing._id.toString())) ? 'fa-solid fa-heart text-danger' : 'fa-regular fa-heart' %>"></i>
                </button>
                <span class="badge bg-white text-dark px-3 py-2 rounded-pill shadow-sm fw-semibold" style="font-size: 0.88rem;">
                    &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %> / night
                </span>
            </div>
        </div>

        <!-- Listing Details Card -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
            <div class="d-flex align-items-center mb-3">
                <div class="avatar-circle me-3 bg-secondary text-white" style="width: 44px; height: 44px; font-size: 1.1rem;">
                    <i class="fa-solid fa-user"></i>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold">Hosted by <%= listing.owner ? listing.owner.username : "Unknown Owner" %></h6>
                    <small class="text-muted">Superhost • Experienced & highly rated</small>
                </div>
            </div>
            
            <hr class="text-muted opacity-25 my-3">

            <h5 class="fw-bold mb-2">About this place</h5>
            <p class="card-text text-secondary leading-relaxed mb-4">
                <%= listing.description %>
            </p>

            <div class="row g-3 text-center border-top border-bottom py-3 my-2">
                <div class="col-4 border-end">
                    <small class="text-muted d-block">Location</small>
                    <span class="fw-semibold"><%= listing.location %></span>
                </div>
                <div class="col-4 border-end">
                    <small class="text-muted d-block">Country</small>
                    <span class="fw-semibold"><%= listing.country %></span>
                </div>
                <div class="col-4">
                    <small class="text-muted d-block">Price</small>
                    <span class="fw-bold text-danger">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %></span>
                </div>
            </div>

            <!-- Owner Action Buttons -->
            <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)){ %>
                <div class="d-flex gap-2 mt-4">
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn px-4 rounded-pill">
                        <i class="fa-solid fa-pen-to-square me-1"></i> Edit Listing
                    </a>
                    <form method="post" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
                        <button class="btn btn-outline-danger px-4 rounded-pill fw-semibold">
                            <i class="fa-solid fa-trash me-1"></i> Delete
                        </button>
                    </form>
                </div>
            <% } %>
        </div>

        <!-- Leave a Review Section -->
        <% if(currUser){ %>
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h4 class="fw-bold mb-3"><i class="fa-solid fa-star text-warning me-2"></i>Leave a Review</h4>
                <form action="/listings/<%= listing.id %>/reviews" method="post" novalidate class="needs-validation">
                    <div class="mb-3">
                        <label for="rating" class="form-label fw-semibold">Rating</label>
                        <fieldset class="starability-slot">
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                    </div>
                    <div class="mb-3">
                        <label for="comment" class="form-label fw-semibold">Comment</label>
                        <textarea name="review[comment]" id="comment" cols="30" rows="4" class="form-control rounded-3" placeholder="Share details of your stay..." required></textarea>
                        <div class="invalid-feedback">Please add some comment for review</div>
                    </div>
                    <button class="btn btn-dark rounded-pill px-4 fw-semibold">Submit Review</button>
                </form>
            </div>
        <% } %>

        <!-- Existing Reviews Grid (3 Cards Per Row) -->
        <% if(listing.reviews && listing.reviews.length > 0 ) { %>
            <div class="mb-5">
                <h4 class="fw-bold mb-3"><i class="fa-solid fa-comments me-2 text-danger"></i>Guest Reviews (<%= listing.reviews.length %>)</h4>
                <div class="row g-3">
                    <% for(review of listing.reviews) { %>
                        <div class="col-lg-4 col-md-6">
                            <div class="card h-100 border-0 shadow-sm rounded-4 p-3">
                                <div class="card-body p-2 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex align-items-center mb-2">
                                            <div class="avatar-circle bg-dark text-white me-2" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                                <i class="fa-solid fa-user"></i>
                                            </div>
                                            <h6 class="card-title fw-bold mb-0">@<%= review.author ? review.author.username : 'Guest' %></h6>
                                        </div>
                                        <p class="starability-result mb-2" data-rating="<%= review.rating %>"></p>
                                        <p class="card-text text-secondary small mb-3"><%= review.comment %></p>
                                    </div>
                                    <% if(currUser && review.author && review.author._id.equals(currUser._id)){ %>
                                        <div class="d-flex gap-2 mt-auto align-self-start">
                                            <!-- Edit Review Button -->
                                            <button type="button" class="btn btn-sm btn-outline-primary border-0 rounded-pill px-2 py-1 small" data-bs-toggle="modal" data-bs-target="#editReviewModal<%= review._id %>">
                                                <i class="fa-solid fa-pen me-1"></i> Edit
                                            </button>

                                            <!-- Delete Review Form -->
                                            <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="d-inline">
                                                <button class="btn btn-sm btn-outline-danger border-0 rounded-pill px-2 py-1 small">
                                                    <i class="fa-solid fa-trash-can me-1"></i> Delete
                                                </button>
                                            </form>
                                        </div>

                                        <!-- Edit Review Modal -->
                                        <div class="modal fade" id="editReviewModal<%= review._id %>" tabindex="-1" aria-labelledby="editReviewLabel<%= review._id %>" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content rounded-4 border-0 shadow-lg p-2">
                                                    <div class="modal-header border-0 pb-0">
                                                        <h5 class="modal-title fw-bold text-dark" id="editReviewLabel<%= review._id %>">
                                                            <i class="fa-solid fa-pen-to-square text-danger me-2"></i>Edit Your Review
                                                        </h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=PUT" method="post">
                                                        <div class="modal-body pt-3">
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold text-dark small mb-1">Rating</label>
                                                                <fieldset class="starability-slot">
                                                                    <input type="radio" id="edit-no-rate-<%= review._id %>" class="input-no-rate" name="review[rating]" value="1" <%= (!review.rating || review.rating === 1) ? 'checked' : '' %> aria-label="No rating." />
                                                                    <input type="radio" id="edit-rate1-<%= review._id %>" name="review[rating]" value="1" <%= review.rating === 1 ? 'checked' : '' %> />
                                                                    <label for="edit-rate1-<%= review._id %>" title="Terrible">1 star</label>
                                                                    <input type="radio" id="edit-rate2-<%= review._id %>" name="review[rating]" value="2" <%= review.rating === 2 ? 'checked' : '' %> />
                                                                    <label for="edit-rate2-<%= review._id %>" title="Not good">2 stars</label>
                                                                    <input type="radio" id="edit-rate3-<%= review._id %>" name="review[rating]" value="3" <%= review.rating === 3 ? 'checked' : '' %> />
                                                                    <label for="edit-rate3-<%= review._id %>" title="Average">3 stars</label>
                                                                    <input type="radio" id="edit-rate4-<%= review._id %>" name="review[rating]" value="4" <%= review.rating === 4 ? 'checked' : '' %> />
                                                                    <label for="edit-rate4-<%= review._id %>" title="Very good">4 stars</label>
                                                                    <input type="radio" id="edit-rate5-<%= review._id %>" name="review[rating]" value="5" <%= review.rating === 5 ? 'checked' : '' %> />
                                                                    <label for="edit-rate5-<%= review._id %>" title="Amazing">5 stars</label>
                                                                </fieldset>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold text-dark small mb-1">Comment</label>
                                                                <textarea name="review[comment]" class="form-control rounded-3 py-2 px-3 bg-light border" rows="4" required placeholder="Update your review details..."><%= review.comment %></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer border-0 pt-0">
                                                            <button type="button" class="btn btn-light border rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-danger-custom rounded-pill px-4 fw-bold shadow-sm">Update Review</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        <% } %>

        <!-- Map Section ("Where you'll be") -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
            <h4 class="fw-bold mb-3"><i class="fa-solid fa-map-location-dot text-danger me-2"></i>Where you'll be</h4>
            <p class="text-muted small mb-3"><%= listing.location %>, <%= listing.country %></p>
            <div id="map" class="rounded-4 overflow-hidden border shadow-sm"></div>
        </div>
    </div>
</div>

<script src="/js/map.js"></script>