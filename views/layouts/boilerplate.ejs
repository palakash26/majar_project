<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Favicon & Brand Tab Icon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="shortcut icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="apple-touch-icon" href="/favicon.svg">
    <title>Wanderlust - Find Your Next Stay</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">

    <!-- Swiper CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <link href="/css/rating.css" rel="stylesheet" />
    
    <!-- Mapbox GL -->
    <link href="https://api.mapbox.com/mapbox-gl-js/v3.1.0/mapbox-gl.css" rel="stylesheet">
    <script src="https://api.mapbox.com/mapbox-gl-js/v3.1.0/mapbox-gl.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
</head>

<body class="d-flex flex-column min-vh-100">
    <!-- Navbar Header -->
    <%- include("../includes/navbar.ejs") %>

    <!-- Main Container -->
    <main class="flex-grow-1 container py-4">
        <%- include("../includes/flash.ejs") %>
        <%- body %>
    </main>

    <!-- Footer Section -->
    <%- include("../includes/footer.ejs") %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
        crossorigin="anonymous"></script>
    <script src="/js/script.js"></script>
    <script>
      async function toggleWishlist(event, listingId) {
        event.preventDefault();
        event.stopPropagation();
        <% if (!currUser) { %>
          window.location.href = "/login";
          return;
        <% } %>
        
        try {
          const btn = event.currentTarget;
          const icon = btn.querySelector("i");
          btn.classList.add("pulse-heart");
          setTimeout(() => btn.classList.remove("pulse-heart"), 350);

          const res = await fetch(`/listings/${listingId}/like`, { method: "POST" });
          const data = await res.json();
          if (data.success) {
            if (data.liked) {
              icon.className = "fa-solid fa-heart text-danger";
            } else {
              icon.className = "fa-regular fa-heart";
              const urlParams = new URLSearchParams(window.location.search);
              if (urlParams.get("filter") === "liked") {
                const col = btn.closest(".col");
                if (col) {
                  col.style.transition = "all 0.3s ease";
                  col.style.opacity = "0";
                  col.style.transform = "scale(0.85)";
                  setTimeout(() => {
                    col.remove();
                    const remaining = document.querySelectorAll(".row-cols-xl-3 .col");
                    if (remaining.length === 0) {
                      window.location.reload();
                    }
                  }, 300);
                }
              }
            }
            const navCount = document.getElementById("nav-wishlist-count");
            if (navCount) {
              navCount.innerText = data.wishlistCount;
            }
          }
        } catch (err) {
          console.error("Error toggling wishlist:", err);
        }
      }
    </script>
    <script>
      function showCustomToast(message, type = 'success') {
        let container = document.getElementById('toast-notification-container');
        if (!container) {
          container = document.createElement('div');
          container.id = 'toast-notification-container';
          container.style.cssText = 'position: fixed; top: 90px; right: 25px; z-index: 9999; display: flex; flex-direction: column; gap: 10px; max-width: 380px; width: 100%; pointer-events: none;';
          document.body.appendChild(container);
        }

        const toast = document.createElement('div');
        toast.className = `toast-popup-card shadow-lg rounded-4 p-3 border d-flex align-items-center justify-content-between`;
        toast.style.cssText = 'pointer-events: auto; transform: translateX(130%); transition: transform 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275); background: #ffffff; border-color: #e2e8f0;';

        const iconClass = type === 'success' ? 'fa-solid fa-circle-check text-success' : 'fa-solid fa-triangle-exclamation text-danger';

        toast.innerHTML = `
          <div class="d-flex align-items-center gap-3 pe-2">
            <div class="toast-icon-circle rounded-circle d-flex align-items-center justify-content-center" style="font-size: 1.4rem; flex-shrink: 0;">
              <i class="${iconClass}"></i>
            </div>
            <div>
              <h6 class="fw-bold mb-0 text-dark" style="font-size: 0.9rem;">${type === 'success' ? 'Wanderlust Notification' : 'Notice'}</h6>
              <p class="text-secondary small mb-0" style="font-size: 0.82rem; line-height: 1.3;">${message}</p>
            </div>
          </div>
          <button type="button" class="btn-close ms-2" style="font-size: 0.75rem;" onclick="this.parentElement.remove()"></button>
        `;

        container.appendChild(toast);

        requestAnimationFrame(() => {
          toast.style.transform = 'translateX(0)';
        });

        setTimeout(() => {
          toast.style.transform = 'translateX(130%)';
          setTimeout(() => toast.remove(), 400);
        }, 4500);
      }
    </script>
</body>

</html>