                        <span class="fw-bold text-danger" id="nav-wishlist-count">
                          <%= (typeof userWishlistCount !=='undefined' ) ? userWishlistCount : 0 %>
                        </span>
                      </a>
                    </div>
                  </div>
                </li>

                <li>
                  <hr class="dropdown-divider my-2">
