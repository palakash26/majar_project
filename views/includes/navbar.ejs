          <div class="search-input-capsule w-100">
            <i class="fa-solid fa-magnifying-glass search-capsule-icon"></i>
            <input class="form-control search-capsule-input" type="search" placeholder="Search destinations, stays..."
              aria-label="Search" name="q" autocomplete="off" spellcheck="false" />
            <button class="btn search-capsule-btn" type="submit" title="Search">
              <i class="fa-solid fa-magnifying-glass"></i>
            </button>
          </div>
        </form>
      </div>

