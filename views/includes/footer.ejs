                    <li><a href="/cancellation-options">Cancellation Options</a></li>
                </ul>
            </div>

            <!-- Column 3: Hosting -->
            <div class="col-lg-3 col-md-6 col-6">
                <h6 class="footer-heading mb-3">Hosting</h6>
                <ul class="list-unstyled footer-links mb-0">
                    <li><a href="/listings/new">Host your home</a></li>
                    <li><a href="/host-cover">Wanderlust Cover for Hosts</a></li>
                    <li><a href="/hosting-resources">Hosting Resources</a></li>
                    <li><a href="/community-forum">Community Forum</a></li>
                    <li><a href="/host-responsibly">Host Responsibly</a></li>
                </ul>
            </div>

            <!-- Column 4: Company & Newsletter -->
            <div class="col-lg-3 col-md-6">
                <h6 class="footer-heading mb-3">Stay Connected</h6>
                <p class="small text-muted mb-3">Subscribe to get secret travel deals & curated stay recommendations.
                </p>

                <form class="newsletter-form mb-3" onsubmit="handleNewsletterSubscribe(event)">
                    <div class="input-group">
                        <input type="email" id="newsletter-email-input"
                            class="form-control rounded-start-pill newsletter-input" placeholder="Your email address"
                            required>
                        <button class="btn btn-danger-custom rounded-end-pill px-3" type="submit"
                            id="newsletter-submit-btn">
                            <i class="fa-solid fa-paper-plane"></i>
                        </button>
                    </div>
                </form>

                <script>
                    async function handleNewsletterSubscribe(event) {
                        event.preventDefault();
                        const emailInput = document.getElementById("newsletter-email-input");
                        const btn = document.getElementById("newsletter-submit-btn");
                        const email = emailInput.value.trim();

                        if (!email) return;

                        btn.disabled = true;
                        btn.innerHTML = `<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>`;

                        try {
                            const res = await fetch("/subscribe", {
                                method: "POST",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify({ email })
                            });
                            const data = await res.json();
                            btn.disabled = false;
                            btn.innerHTML = `<i class="fa-solid fa-paper-plane"></i>`;

                            if (data.success) {
                                emailInput.value = "";
                                showCustomToast(data.message, "success");
                            } else {
                                showCustomToast(data.message, "error");
                            }
                        } catch (err) {
                            btn.disabled = false;
                            btn.innerHTML = `<i class="fa-solid fa-paper-plane"></i>`;
                            showCustomToast("Subscription failed. Please try again.", "error");
                        }
                    }
                </script>

                <div class="d-flex align-items-center gap-3 text-muted small mt-2">
                    <span><i class="fa-solid fa-globe me-1"></i> English (IN)</span>
                    <span><i class="fa-solid fa-indian-rupee-sign me-1"></i> INR</span>
                </div>
