<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center align-items-center my-5">
    <div class="col-xl-4 col-lg-5 col-md-7 col-sm-10">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white p-4 p-md-5">
            <!-- Header -->
            <div class="text-center mb-4">
                <div class="auth-icon-circle bg-danger-subtle text-danger mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle" style="width: 60px; height: 60px; font-size: 1.5rem;">
                    <i class="fa-solid fa-right-to-bracket"></i>
                </div>
                <h3 class="fw-bold text-dark mb-1">Welcome Back</h3>
                <p class="text-muted small">Log in to manage your stays & saved wishlists</p>
            </div>

            <!-- Login Form -->
            <form action="/login" method="POST" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="username" class="form-label fw-semibold text-dark small">Username</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 rounded-start-pill ps-3 text-secondary">
                            <i class="fa-solid fa-user"></i>
                        </span>
                        <input type="text" placeholder="Enter your username" id="username" name="username" class="form-control bg-light border-start-0 rounded-end-pill py-2" autocomplete="username" required>
                        <div class="invalid-feedback ps-2">Please enter your username.</div>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label for="password" class="form-label fw-semibold text-dark small mb-0">Password</label>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 rounded-start-pill ps-3 text-secondary">
                            <i class="fa-solid fa-lock"></i>
                        </span>
                        <input type="password" placeholder="Enter your password" id="password" name="password" autocomplete="current-password" class="form-control bg-light border-start-0 rounded-end-pill py-2" required>
                        <div class="invalid-feedback ps-2">Please enter your password.</div>
                    </div>
                </div>

                <button type="submit" class="btn btn-danger-custom w-100 rounded-pill py-25 fw-bold shadow-sm mb-3">
                    <i class="fa-solid fa-right-to-bracket me-2"></i> Log In
                </button>
            </form>

            <!-- Footer Switch Link -->
            <div class="text-center border-top pt-3 mt-2">
                <p class="text-muted small mb-0">
                    Don't have an account yet? 
                    <a href="/signup" class="text-danger fw-bold text-decoration-none ms-1">Create Account</a>
                </p>
            </div>
        </div>
    </div>
</div>