<% layout("/layouts/boilerplate") %>

<div class="container my-5">
  <!-- Header -->
  <div class="text-center mb-5">
    <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-bold text-uppercase mb-2">Responsible Hosting</span>
    <h1 class="fw-extrabold display-5 text-dark mb-2">Host Responsibly in Your Community</h1>
    <p class="text-muted lead mx-auto" style="max-width: 700px;">
      Building trust with neighbors, following local laws, and creating safe, welcoming spaces for guests.
    </p>
  </div>

  <!-- Key Standards Grid -->
  <div class="row g-4 mb-5">
    <div class="col-md-6">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
        <div class="d-flex align-items-center mb-3">
          <div class="icon-circle bg-danger-subtle text-danger me-3 d-flex align-items-center justify-content-center rounded-circle" style="width: 48px; height: 48px; font-size: 1.25rem;">
            <i class="fa-solid fa-volume-xmark"></i>
          </div>
          <h5 class="fw-bold text-dark mb-0">Noise & Party Prevention</h5>
        </div>
        <p class="text-secondary small mb-0">
          Wanderlust strictly prohibits unauthorized parties and disruptive noise. Set clear quiet hours in your house rules and inform guests about quiet neighborhood standards.
        </p>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
        <div class="d-flex align-items-center mb-3">
          <div class="icon-circle bg-primary-subtle text-primary me-3 d-flex align-items-center justify-content-center rounded-circle" style="width: 48px; height: 48px; font-size: 1.25rem;">
            <i class="fa-solid fa-scale-balanced"></i>
          </div>
          <h5 class="fw-bold text-dark mb-0">Local Laws & Permits</h5>
        </div>
        <p class="text-secondary small mb-0">
          Before hosting, check your local municipal regulations, zoning permits, HOA rules, and lease agreements to ensure short-term hosting is fully compliant.
        </p>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
        <div class="d-flex align-items-center mb-3">
          <div class="icon-circle bg-warning-subtle text-warning me-3 d-flex align-items-center justify-content-center rounded-circle" style="width: 48px; height: 48px; font-size: 1.25rem;">
            <i class="fa-solid fa-fire-extinguisher"></i>
          </div>
          <h5 class="fw-bold text-dark mb-0">Safety & Emergency Essentials</h5>
        </div>
        <p class="text-secondary small mb-0">
          Equip your property with working smoke detectors, carbon monoxide alarms, first-aid kits, and a clear emergency exit card posted near the entryway.
        </p>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
        <div class="d-flex align-items-center mb-3">
          <div class="icon-circle bg-info-subtle text-info me-3 d-flex align-items-center justify-content-center rounded-circle" style="width: 48px; height: 48px; font-size: 1.25rem;">
            <i class="fa-solid fa-receipt"></i>
          </div>
          <h5 class="fw-bold text-dark mb-0">Tax & Financial Compliance</h5>
        </div>
        <p class="text-secondary small mb-0">
          Understand occupancy taxes, income reporting, and local business taxes applicable to hosting in your city or district.
        </p>
      </div>
    </div>
  </div>

  <!-- Neighborhood Promise Banner -->
  <div class="bg-light p-4 p-md-5 rounded-4 border text-center">
    <h4 class="fw-bold text-dark mb-2">Our Neighborhood Promise</h4>
    <p class="text-muted small mx-auto mb-4" style="max-width: 600px;">
      Great hosting starts with being a great neighbor. Together, we maintain safe, vibrant communities everywhere Wanderlust operates.
    </p>
    <a href="/listings/new" class="btn btn-danger-custom rounded-pill px-4 py-25 fw-bold shadow">
      Host Your Property Responsibly
    </a>
  </div>
</div>
