<% layout("/layouts/boilerplate") %>

<div class="container my-5">
  <!-- Header -->
  <div class="row align-items-center mb-5">
    <div class="col-lg-8">
      <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-bold text-uppercase mb-2">Host Network</span>
      <h1 class="fw-extrabold display-5 text-dark mb-2">Wanderlust Community Forum</h1>
      <p class="text-muted lead mb-0">Connect, share experiences, and get advice from top-rated hosts across 190+ countries.</p>
    </div>
    <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
      <a href="/listings/new" class="btn btn-danger-custom rounded-pill px-4 py-25 fw-bold shadow">
        <i class="fa-solid fa-pen-to-square me-2"></i> Start a Discussion
      </a>
    </div>
  </div>

  <!-- Featured Discussion Categories -->
  <div class="row g-4 mb-5">
    <!-- Thread 1 -->
    <div class="col-md-6">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1">New Host Advice</span>
          <span class="text-muted small"><i class="fa-regular fa-clock me-1"></i> 2 hours ago</span>
        </div>
        <h5 class="fw-bold text-dark mb-2">Best self check-in keypad setups for remote properties?</h5>
        <p class="text-secondary small mb-3">
          "Hey fellow hosts! I'm adding smart keypads to my beachfront listing in Goa. What brands do you recommend for battery life and guest ease?"
        </p>
        <div class="d-flex align-items-center justify-content-between pt-3 border-top">
          <div class="d-flex align-items-center">
            <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-2" style="width: 32px; height: 32px; font-size: 0.85rem;">
              AK
            </div>
            <span class="fw-semibold text-dark small">Akash (Superhost)</span>
          </div>
          <span class="text-muted small"><i class="fa-regular fa-comment me-1"></i> 18 replies</span>
        </div>
      </div>
    </div>

    <!-- Thread 2 -->
    <div class="col-md-6">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1">Decor & Design</span>
          <span class="text-muted small"><i class="fa-regular fa-clock me-1"></i> 5 hours ago</span>
        </div>
        <h5 class="fw-bold text-dark mb-2">How we doubled our weekend bookings with luxury outdoor lighting</h5>
        <p class="text-secondary small mb-3">
          "Sharing photos of our warm patio bistro lights and firepit area setup. Small investments can completely transform your listing photos!"
        </p>
        <div class="d-flex align-items-center justify-content-between pt-3 border-top">
          <div class="d-flex align-items-center">
            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-2" style="width: 32px; height: 32px; font-size: 0.85rem;">
              PL
            </div>
            <span class="fw-semibold text-dark small">Palak (Host)</span>
          </div>
          <span class="text-muted small"><i class="fa-regular fa-comment me-1"></i> 34 replies</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Community Guidelines Card -->
  <div class="bg-light border rounded-4 p-4 p-md-5">
    <div class="row align-items-center">
      <div class="col-md-2 text-center text-md-start mb-3 mb-md-0">
        <div class="text-danger" style="font-size: 3rem;">
          <i class="fa-solid fa-people-group"></i>
        </div>
      </div>
      <div class="col-md-10">
        <h4 class="fw-bold text-dark mb-1">Host Community Guidelines</h4>
        <p class="text-secondary small mb-0">
          Our forum is a respectful space designed for host collaboration, feedback, and knowledge sharing. Treat fellow hosts with kindness, keep discussions constructve, and enjoy growing your hosting business together.
        </p>
      </div>
    </div>
  </div>
</div>
