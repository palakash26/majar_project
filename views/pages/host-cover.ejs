<% layout("/layouts/boilerplate") %>

<div class="container my-5">
  <!-- Hero Section -->
  <div class="text-center mb-5 py-4 bg-danger-subtle rounded-4 p-4 p-md-5 position-relative overflow-hidden">
    <span class="badge bg-danger text-white px-3 py-2 rounded-pill fw-bold text-uppercase tracking-wide mb-3">Host Protection</span>
    <h1 class="fw-extrabold display-5 text-dark mb-3">Wanderlust Cover for Hosts</h1>
    <p class="lead text-secondary mx-auto" style="max-width: 700px;">
      Top-to-bottom protection for every Wanderlust host. Always included, always free whenever you host a stay.
    </p>
    <a href="/listings/new" class="btn btn-danger-custom rounded-pill px-4 py-25 fw-bold shadow mt-2">
      <i class="fa-solid fa-house-user me-2"></i> Start Hosting Risk-Free
    </a>
  </div>

  <!-- Coverage Comparison Grid -->
  <div class="row g-4 mb-5">
    <div class="col-md-4">
      <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center bg-white">
        <div class="icon-circle bg-primary-subtle text-primary mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle" style="width: 60px; height: 60px; font-size: 1.5rem;">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
        <h4 class="fw-bold text-dark mb-2">$3M Damage Protection</h4>
        <p class="text-muted small">
          Covers your home and belongings if they are damaged by guests during a stay, including rare art, valuables, and auto protection.
        </p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center bg-white">
        <div class="icon-circle bg-success-subtle text-success mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle" style="width: 60px; height: 60px; font-size: 1.5rem;">
          <i class="fa-solid fa-user-shield"></i>
        </div>
        <h4 class="fw-bold text-dark mb-2">$1M Liability Insurance</h4>
        <p class="text-muted small">
          Protects you in the rare event that a guest gets injured or their property is damaged while staying at your listing.
        </p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center bg-white">
        <div class="icon-circle bg-warning-subtle text-warning mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle" style="width: 60px; height: 60px; font-size: 1.5rem;">
          <i class="fa-solid fa-headset"></i>
        </div>
        <h4 class="fw-bold text-dark mb-2">24/7 Priority Support</h4>
        <p class="text-muted small">
          Access a dedicated line of safety specialists trained to help hosts resolve any urgent issue, anytime, day or night.
        </p>
      </div>
    </div>
  </div>

  <!-- FAQ Section -->
  <div class="bg-light p-4 p-md-5 rounded-4 border">
    <h3 class="fw-bold text-dark mb-4 text-center">Frequently Asked Questions</h3>
    <div class="accordion accordion-flush" id="coverFAQ">
      <div class="accordion-item bg-transparent border-bottom">
        <h2 class="accordion-header">
          <button class="accordion-button bg-transparent fw-bold text-dark shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
            Is Wanderlust Cover really free for all hosts?
          </button>
        </h2>
        <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#coverFAQ">
          <div class="accordion-body text-secondary">
            Yes! Wanderlust Cover is automatically included with every listing you publish on Wanderlust. There are no opt-in fees or hidden charges.
          </div>
        </div>
      </div>

      <div class="accordion-item bg-transparent border-bottom">
        <h2 class="accordion-header">
          <button class="accordion-button collapsed bg-transparent fw-bold text-dark shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
            How do I file a damage protection claim?
          </button>
        </h2>
        <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#coverFAQ">
          <div class="accordion-body text-secondary">
            You can initiate a claim directly through your host dashboard within 14 days of checkout. Our resolution center guides you through submitting photos and receipts for fast reimbursement.
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
