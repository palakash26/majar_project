<% layout("/layouts/boilerplate") %>
<div class="container my-5" style="max-width: 900px;">
  <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
    <div class="d-flex align-items-center mb-4">
      <div class="icon-circle bg-info-subtle text-info me-3 p-3 rounded-circle fs-3">
        <i class="fa-solid fa-hands-holding-child"></i>
      </div>
      <div>
        <h2 class="fw-bold text-dark mb-1">Anti-Discrimination Policy</h2>
        <p class="text-muted small mb-0">Building an Inclusive & Respectful Global Community</p>
      </div>
    </div>
    <hr class="my-4">
    
    <p class="text-secondary leading-relaxed mb-4">
      At Wanderlust, our goal is to bring the world closer together by fostering human connection and creating a community where anyone can belong anywhere. Discrimination based on race, religion, national origin, disability, sex, gender identity, or sexual orientation is strictly prohibited.
    </p>

    <h5 class="fw-bold text-dark mt-3 mb-2">Host & Guest Guidelines</h5>
    <ul class="text-secondary leading-relaxed mb-4 ps-3">
      <li class="mb-2">Hosts may not decline a guest based on race, color, ethnicity, religion, or national origin.</li>
      <li class="mb-2">Hosts may not impose different terms or conditions based on guest identity.</li>
      <li>Guests must treat hosts, property, and neighbors with dignity and respect.</li>
    </ul>
  </div>
</div>
