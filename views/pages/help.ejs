<% layout("/layouts/boilerplate") %>
<div class="container my-5" style="max-width: 900px;">
  <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
    <div class="d-flex align-items-center mb-4">
      <div class="icon-circle bg-success-subtle text-success me-3 p-3 rounded-circle fs-3">
        <i class="fa-solid fa-headset"></i>
      </div>
      <div>
        <h2 class="fw-bold text-dark mb-1">Help Center</h2>
        <p class="text-muted small mb-0">24/7 Customer Support & Frequently Asked Questions</p>
      </div>
    </div>
    <hr class="my-4">
    
    <div class="row g-4">
      <div class="col-md-6">
        <div class="p-3 bg-light rounded-3 h-100">
          <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-calendar-check text-danger me-2"></i>How to Book a Stay</h6>
          <p class="text-secondary small mb-0">Browse through categories or search destinations, select your preferred stay, and complete your reservation instantly.</p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="p-3 bg-light rounded-3 h-100">
          <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-house-medical text-danger me-2"></i>Host Assistance</h6>
          <p class="text-secondary small mb-0">Learn how to create compelling listings, upload high-quality photos, set competitive rates, and manage guest reviews.</p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="p-3 bg-light rounded-3 h-100">
          <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-heart text-danger me-2"></i>Managing Wishlists</h6>
          <p class="text-secondary small mb-0">Click the heart icon on any stay card to add it to your profile wishlist for quick access later.</p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="p-3 bg-light rounded-3 h-100">
          <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-shield-halved text-danger me-2"></i>Safety & Support</h6>
          <p class="text-secondary small mb-0">Need urgent assistance during your stay? Our dedicated support team is available 24/7 at support@wanderlust.com.</p>
        </div>
      </div>
    </div>
  </div>
</div>
