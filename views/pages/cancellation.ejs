<% layout("/layouts/boilerplate") %>
<div class="container my-5" style="max-width: 900px;">
  <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
    <div class="d-flex align-items-center mb-4">
      <div class="icon-circle bg-danger-subtle text-danger me-3 p-3 rounded-circle fs-3">
        <i class="fa-solid fa-calendar-xmark"></i>
      </div>
      <div>
        <h2 class="fw-bold text-dark mb-1">Cancellation Options</h2>
        <p class="text-muted small mb-0">Flexible Booking Policies & Refund Terms</p>
      </div>
    </div>
    <hr class="my-4">
    
    <div class="row g-4 mb-4">
      <div class="col-md-4">
        <div class="p-3 bg-light rounded-3 h-100 border-start border-4 border-success">
          <h6 class="fw-bold text-dark mb-1">Flexible</h6>
          <p class="text-secondary small mb-0">Full refund up to 24 hours before check-in. Managed directly in your profile.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="p-3 bg-light rounded-3 h-100 border-start border-4 border-warning">
          <h6 class="fw-bold text-dark mb-1">Moderate</h6>
          <p class="text-secondary small mb-0">Full refund up to 5 days before check-in. Partial refund thereafter.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="p-3 bg-light rounded-3 h-100 border-start border-4 border-danger">
          <h6 class="fw-bold text-dark mb-1">Firm / Strict</h6>
          <p class="text-secondary small mb-0">Full refund up to 14 days before check-in. Subject to host review.</p>
        </div>
      </div>
    </div>
  </div>
</div>
