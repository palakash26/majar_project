<% layout("/layouts/boilerplate") %>
<div class="container my-5" style="max-width: 900px;">
  <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
    <div class="d-flex align-items-center mb-4">
      <div class="icon-circle bg-warning-subtle text-warning me-3 p-3 rounded-circle fs-3">
        <i class="fa-solid fa-shield-cat"></i>
      </div>
      <div>
        <h2 class="fw-bold text-dark mb-1">AirCover & Safety</h2>
        <p class="text-muted small mb-0">Comprehensive Protection for Every Stay and Host</p>
      </div>
    </div>
    <hr class="my-4">
    
    <div class="row g-4 mb-4">
      <div class="col-md-6">
        <div class="border rounded-4 p-4 h-100">
          <h5 class="fw-bold text-dark mb-2"><i class="fa-solid fa-user-shield text-danger me-2"></i>Guest Protection</h5>
          <ul class="text-secondary small mb-0 ps-3">
            <li class="mb-2">Booking Protection Guarantee</li>
            <li class="mb-2">Check-in Guarantee</li>
            <li class="mb-2">Get What You Booked Guarantee</li>
            <li>24-Hour Safety Line Access</li>
          </ul>
        </div>
      </div>
      <div class="col-md-6">
        <div class="border rounded-4 p-4 h-100">
          <h5 class="fw-bold text-dark mb-2"><i class="fa-solid fa-building-shield text-danger me-2"></i>Host Protection</h5>
          <ul class="text-secondary small mb-0 ps-3">
            <li class="mb-2">Up to ₹1,00,00,000 Property Damage Protection</li>
            <li class="mb-2">Host Liability Insurance</li>
            <li class="mb-2">Guest Identity Verification</li>
            <li>Screening Technology for High-Risk Bookings</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
