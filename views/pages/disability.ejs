<% layout("/layouts/boilerplate") %>
<div class="container my-5" style="max-width: 900px;">
  <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
    <div class="d-flex align-items-center mb-4">
      <div class="icon-circle bg-success-subtle text-success me-3 p-3 rounded-circle fs-3">
        <i class="fa-solid fa-wheelchair"></i>
      </div>
      <div>
        <h2 class="fw-bold text-dark mb-1">Disability Support & Accessibility</h2>
        <p class="text-muted small mb-0">Accessible Stays and Features for Every Traveler</p>
      </div>
    </div>
    <hr class="my-4">
    
    <p class="text-secondary leading-relaxed mb-4">
      We believe travel should be accessible to everyone. Hosts can highlight specific accessibility features in their listings, such as step-free paths to the entrance, widened doorways, roll-in showers, and accessible parking spaces.
    </p>

    <h5 class="fw-bold text-dark mt-3 mb-2">Service Animals Policy</h5>
    <p class="text-secondary leading-relaxed mb-0">
      Service animals are always permitted in stays on Wanderlust without extra fees or restrictions, in accordance with global accessibility guidelines.
    </p>
  </div>
</div>
