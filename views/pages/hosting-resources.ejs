<% layout("/layouts/boilerplate") %>

<div class="container my-5">
  <!-- Header -->
  <div class="text-center mb-5">
    <h1 class="fw-extrabold display-5 text-dark mb-2">Hosting Resources & Guides</h1>
    <p class="text-muted lead mx-auto" style="max-width: 650px;">
      Everything you need to set up your space, attract guests, earn great reviews, and maximize your hosting potential.
    </p>
  </div>

  <!-- Resource Cards Grid -->
  <div class="row g-4 mb-5">
    <div class="col-md-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 h-100 p-4 text-center bg-white hover-lift">
        <div class="text-danger mb-3" style="font-size: 2.2rem;">
          <i class="fa-solid fa-camera font-awesome"></i>
        </div>
        <h5 class="fw-bold text-dark mb-2">Photography Tips</h5>
        <p class="text-muted small">Learn how high-quality natural lighting and wide shots can boost your listing views by up to 40%.</p>
        <a href="/listings/new" class="text-danger fw-bold text-decoration-none small">Read Guide <i class="fa-solid fa-arrow-right ms-1"></i></a>
      </div>
    </div>

    <div class="col-md-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 h-100 p-4 text-center bg-white hover-lift">
        <div class="text-primary mb-3" style="font-size: 2.2rem;">
          <i class="fa-solid fa-hand-holding-dollar"></i>
        </div>
        <h5 class="fw-bold text-dark mb-2">Smart Pricing Strategies</h5>
        <p class="text-muted small">Discover seasonal pricing tricks and weekend rate optimization to maximize occupancy year-round.</p>
        <a href="/listings" class="text-danger fw-bold text-decoration-none small">Explore Tips <i class="fa-solid fa-arrow-right ms-1"></i></a>
      </div>
    </div>

    <div class="col-md-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 h-100 p-4 text-center bg-white hover-lift">
        <div class="text-success mb-3" style="font-size: 2.2rem;">
          <i class="fa-solid fa-comments"></i>
        </div>
        <h5 class="fw-bold text-dark mb-2">Guest Communication</h5>
        <p class="text-muted small">Craft automated welcome notes, local recommendations, and check-in instructions that earn 5-star reviews.</p>
        <a href="/help" class="text-danger fw-bold text-decoration-none small">Learn More <i class="fa-solid fa-arrow-right ms-1"></i></a>
      </div>
    </div>

    <div class="col-md-6 col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 h-100 p-4 text-center bg-white hover-lift">
        <div class="text-warning mb-3" style="font-size: 2.2rem;">
          <i class="fa-solid fa-broom"></i>
        </div>
        <h5 class="fw-bold text-dark mb-2">Enhanced Cleaning</h5>
        <p class="text-muted small">Follow our step-by-step cleaning checklist to guarantee guest safety and spotless stay experiences.</p>
        <a href="/host-responsibly" class="text-danger fw-bold text-decoration-none small">View Checklist <i class="fa-solid fa-arrow-right ms-1"></i></a>
      </div>
    </div>
  </div>

  <!-- Callout Banner -->
  <div class="bg-dark text-white p-4 p-md-5 rounded-4 shadow-lg d-flex flex-column flex-md-row align-items-center justify-content-between">
    <div>
      <h3 class="fw-bold mb-2">Ready to become a Superhost?</h3>
      <p class="text-white-50 mb-md-0">Create your listing in under 5 minutes and connect with guests worldwide.</p>
    </div>
    <a href="/listings/new" class="btn btn-danger-custom rounded-pill px-4 py-25 fw-bold shadow">
      Create Your Listing
    </a>
  </div>
</div>
