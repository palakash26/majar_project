<% layout("/layouts/boilerplate") %>

<div class="container py-5 my-3">
  <div class="row justify-content-center text-center">
    <div class="col-lg-8 col-md-10">
      
      <% if (typeof statusCode !== 'undefined' && statusCode === 404) { %>
        <!-- 404 USER-FRIENDLY ERROR VIEW -->
        <div class="error-card-wrapper p-4 p-md-5 rounded-4 shadow-sm bg-white border">
          
          <!-- Animated Compass / 404 Badge -->
          <div class="mb-4 d-flex justify-content-center">
            <div class="error-icon-badge rounded-circle d-flex align-items-center justify-content-center shadow-sm">
              <i class="fa-solid fa-compass text-danger fa-spin-pulse" style="--fa-animation-duration: 12s; font-size: 3.5rem;"></i>
            </div>
          </div>

          <!-- Title & Badges -->
          <span class="badge rounded-pill bg-danger-subtle text-danger fw-bold px-3 py-2 fs-6 mb-3">
            <i class="fa-solid fa-triangle-exclamation me-1"></i> Error 404
          </span>
          <h1 class="display-5 fw-extrabold text-dark mb-3" style="letter-spacing: -0.5px;">
            Oops! Page Not Found
          </h1>
          <p class="text-secondary fs-5 mb-4 mx-auto" style="max-width: 540px; line-height: 1.6;">
            We couldn't find the page <code class="bg-light text-danger px-2 py-1 rounded small fw-bold"><%= message %></code>. It might have been moved, renamed, or no longer exists.
          </p>

          <!-- Interactive Search Bar on 404 Page -->
          <div class="search-box-404 mx-auto mb-4" style="max-width: 480px;">
            <form action="/listings" method="GET" class="d-flex align-items-center bg-light rounded-pill p-2 border shadow-sm">
              <i class="fa-solid fa-magnifying-glass text-secondary ms-3 me-2"></i>
              <input type="text" name="search" class="form-control border-0 bg-transparent shadow-none pe-2" placeholder="Search for destinations, hotels, or stays..." required />
              <button type="submit" class="btn btn-danger-custom rounded-pill px-4 py-2 fw-semibold">
                Search
              </button>
            </form>
          </div>

          <!-- Quick Action Buttons -->
          <div class="d-flex flex-wrap justify-content-center gap-3 mb-4">
            <a href="/listings" class="btn btn-danger-custom btn-lg rounded-pill px-4 py-2 text-white fw-bold d-inline-flex align-items-center">
              <i class="fa-solid fa-house me-2"></i> Back to Home
            </a>
            <button onclick="window.history.back()" class="btn btn-outline-secondary btn-lg rounded-pill px-4 py-2 fw-semibold d-inline-flex align-items-center">
              <i class="fa-solid fa-arrow-left me-2"></i> Go Back
            </button>
          </div>

          <!-- Quick Category Suggestions -->
          <div class="border-top pt-4 mt-4">
            <p class="text-muted small fw-bold text-uppercase tracking-wider mb-3">
              Popular Stays You Might Like
            </p>
            <div class="d-flex flex-wrap justify-content-center gap-2">
              <a href="/listings" class="badge rounded-pill bg-light text-dark border px-3 py-2 text-decoration-none hover-shadow">
                🏖️ Beachfront
              </a>
              <a href="/listings" class="badge rounded-pill bg-light text-dark border px-3 py-2 text-decoration-none hover-shadow">
                🏔️ Mountain Views
              </a>
              <a href="/listings" class="badge rounded-pill bg-light text-dark border px-3 py-2 text-decoration-none hover-shadow">
                🏰 Iconic Cities
              </a>
              <a href="/listings" class="badge rounded-pill bg-light text-dark border px-3 py-2 text-decoration-none hover-shadow">
                🏊 Amazing Pools
              </a>
              <a href="/listings" class="badge rounded-pill bg-light text-dark border px-3 py-2 text-decoration-none hover-shadow">
                🏕️ Camping & Cabins
              </a>
            </div>
          </div>

        </div>

      <% } else { %>

        <!-- GENERAL SERVER ERROR VIEW (500 or others) -->
        <div class="error-card-wrapper p-4 p-md-5 rounded-4 shadow-sm bg-white border">
          <div class="mb-4 d-flex justify-content-center">
            <div class="error-icon-badge rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="background-color: #fff1f2;">
              <i class="fa-solid fa-bug text-danger" style="font-size: 3rem;"></i>
            </div>
          </div>

          <span class="badge rounded-pill bg-danger text-white fw-bold px-3 py-2 fs-6 mb-3">
            Error <%= typeof statusCode !== 'undefined' ? statusCode : 500 %>
          </span>
          <h1 class="display-6 fw-bold text-dark mb-3">
            Something went wrong!
          </h1>
          <p class="text-secondary fs-5 mb-4 mx-auto" style="max-width: 500px;">
            <%= message || "We encountered an unexpected issue while processing your request. Please try again later." %>
          </p>

          <div class="d-flex flex-wrap justify-content-center gap-3">
            <a href="/listings" class="btn btn-danger-custom btn-lg rounded-pill px-4 py-2 text-white fw-bold d-inline-flex align-items-center">
              <i class="fa-solid fa-house me-2"></i> Return to Homepage
            </a>
            <button onclick="window.location.reload()" class="btn btn-outline-secondary btn-lg rounded-pill px-4 py-2 fw-semibold d-inline-flex align-items-center">
              <i class="fa-solid fa-rotate-right me-2"></i> Refresh Page
            </button>
          </div>
        </div>

      <% } %>

    </div>
  </div>
</div>

<style>
  .error-card-wrapper {
    background: #ffffff;
    border-color: #e2e8f0 !important;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05) !important;
    transition: all 0.3s ease;
  }
  .error-icon-badge {
    width: 100px;
    height: 100px;
    background-color: #fff1f2;
    border: 3px solid #ffe4e6;
  }
  .hover-shadow {
    transition: all 0.2s ease;
  }
  .hover-shadow:hover {
    background-color: #fe424d !important;
    color: #ffffff !important;
    border-color: #fe424d !important;
    transform: translateY(-2px);
  }
</style>